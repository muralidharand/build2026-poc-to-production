# CampusMate Helpdesk — environment variables
# Copy this file to .env and fill in the values.

# ---------------------------------------------------------------------------
# Required: Azure AI Foundry project endpoint
# ---------------------------------------------------------------------------
AZURE_AI_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>

# ---------------------------------------------------------------------------
# Model deployment
# ---------------------------------------------------------------------------
MODEL_DEPLOYMENT_NAME=gpt-5

# ---------------------------------------------------------------------------
# Instrumentation
# ---------------------------------------------------------------------------
# Set to "true" to enable OpenTelemetry tracing
ENABLE_INSTRUMENTATION=true
# Set to "true" to include message content in traces (sensitive)
ENABLE_SENSITIVE_DATA=false

# ---------------------------------------------------------------------------
# Procedural memory
# ---------------------------------------------------------------------------
# "hybrid" (default) | "live" | "seed"
PROCEDURAL_MEMORY_MODE=hybrid
# Name of the Foundry Memory Store (only needed for live/hybrid mode)
# PROCEDURAL_MEMORY_STORE_NAME=campusmate-procedural

# ---------------------------------------------------------------------------
# MCP Toolbox (optional)
# ---------------------------------------------------------------------------
# TOOLBOX_ENDPOINT=http://localhost:5000
