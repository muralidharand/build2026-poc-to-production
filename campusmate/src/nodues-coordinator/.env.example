# No-Dues Coordinator — environment variables
# Copy this file to .env and fill in the values.

# ---------------------------------------------------------------------------
# Required: Azure AI Foundry project endpoint
# ---------------------------------------------------------------------------
AZURE_AI_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>

# ---------------------------------------------------------------------------
# Model deployment
# ---------------------------------------------------------------------------
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5

# ---------------------------------------------------------------------------
# Instrumentation
# ---------------------------------------------------------------------------
ENABLE_INSTRUMENTATION=true
ENABLE_SENSITIVE_DATA=false

# ---------------------------------------------------------------------------
# Approval web server
# ---------------------------------------------------------------------------
APPROVAL_SERVER_PORT=8090
# Public URL for the approval server (used in Teams cards)
# APPROVAL_SERVER_URL=https://<your-host>:8090

# ---------------------------------------------------------------------------
# Durable Task (optional — uses in-process fallback when not set)
# ---------------------------------------------------------------------------
# DURABLE_TASK_ENDPOINT=<grpc-endpoint>
# DURABLE_TASK_TASKHUB=campusmate-approvals

# ---------------------------------------------------------------------------
# Teams integration (optional)
# ---------------------------------------------------------------------------
# APPROVER_UPN=approver@yourtenant.onmicrosoft.com
# TEAMS_APP_ID=<bot-app-id>
# TEAMS_APP_PASSWORD=<bot-app-password>
# TEAMS_TENANT_ID=<tenant-id>
# TEAMS_SERVICE_URL=https://smba.trafficmanager.net/apis/
# TEAMS_APPROVER_CONVERSATION_ID=<conversation-id>
# TEAMS_STATE_BLOB_URL=<blob-sas-url>
